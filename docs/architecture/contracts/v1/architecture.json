  "designAcceptance": [
    "same-canonical-preview-home-and-browse",
    "no-progress-on-unverified-start",
    "no-progress-for-alternative-modes",
    "same-media-distinct-occurrences",
    "exact-provider-identity-recovery",
    "revision-conflict-no-silent-reset",
    "concurrent-session-lease-fencing",
    "idempotent-completion",
    "permission-rechecked-before-autonext",
    "legacy-bidirectional-import-export-with-loss-report"
  ]
}
