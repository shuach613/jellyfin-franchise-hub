{
  "schemaVersion": 1,
  "status": "design_only",
  "project": "Franchise Hub",
  "target": "Jellyfin 12.2 Web",
  "defaultMode": "chronological",
  "canonicalOrder": {
    "selection": "explicit_primaryChronologyRowId",
    "fallbackToReleaseOrder": false,
    "serverAuthoritative": true,
    "clientQueueIsAuthoritative": false,
    "progressOwner": "verified_server_event",
    "allowNativeWatchedFlagsToDetermineNext": false
  },
  "identity": [
    "franchiseId",
    "orderId",
    "orderRevision",
    "slotId",
    "occurrenceId",
    "logicalMediaKey",
    "jellyfinItemId",
    "queueSnapshotId",
    "sessionId",
    "playbackInstanceId",
    "userId"
  ],
  "modeDefinitions": [
    {
      "id": "chronological",
      "source": "primary",
      "tracksCanonical": true,
      "requiresConfiguredOrder": true,
      "selection": "none"
    },
    {
      "id": "movies_only",
      "source": "primary_filter",
      "tracksCanonical": false,
      "requiresConfiguredOrder": true,
      "selection": "none"
    },
    {
      "id": "series_only",
      "source": "primary_filter",
      "tracksCanonical": false,
      "requiresConfiguredOrder": true,
      "selection": "none"
    },
    {
      "id": "complete_series",
      "source": "jellyfin_series",
      "tracksCanonical": false,
      "requiresConfiguredOrder": false,
      "selection": "seriesId"
    },
    {
      "id": "selected_era",
      "source": "primary_filter",
      "tracksCanonical": false,
      "requiresConfiguredOrder": true,
      "selection": "eraId"
    },
    {
      "id": "custom_selection",
      "source": "explicit",
      "tracksCanonical": false,
      "requiresConfiguredOrder": false,
      "selection": "itemSlots"
    },
    {
      "id": "release_order",
      "source": "explicit_configured_order",
      "tracksCanonical": false,
      "requiresConfiguredOrder": true,
      "selection": "releaseOrderId"
    },
    {
      "id": "watch_only",
      "source": "explicit",
      "tracksCanonical": false,
      "requiresConfiguredOrder": false,
      "selection": "itemId"
    }
  ],
  "apiRoutes": [
    {
      "method": "GET",
      "path": "/FranchiseHub/v1/franchises/{franchiseId}/orders",
      "auth": "viewer",
      "canonicalMutation": false
    },
    {
      "method": "GET",
      "path": "/FranchiseHub/v1/franchises/{franchiseId}/progress",
      "auth": "viewer",
      "canonicalMutation": false
    },
    {
      "method": "POST",
      "path": "/FranchiseHub/v1/franchises/{franchiseId}/resolve",
      "auth": "viewer",
      "canonicalMutation": false
    },
    {
      "method": "POST",
      "path": "/FranchiseHub/v1/playback/sessions",
      "auth": "viewer",
      "canonicalMutation": false
    },
    {
      "method": "POST",
      "path": "/FranchiseHub/v1/playback/sessions/{sessionId}/launch",
      "auth": "viewer",
      "canonicalMutation": false
    },
    {
      "method": "GET",
      "path": "/FranchiseHub/v1/playback/sessions/{sessionId}",
      "auth": "viewer",
      "canonicalMutation": false
    },
    {
      "method": "POST",
      "path": "/FranchiseHub/v1/playback/sessions/{sessionId}/cancel",
      "auth": "viewer",
      "canonicalMutation": false
    },
    {
      "method": "POST",
      "path": "/FranchiseHub/v1/playback/sessions/{sessionId}/takeover",
      "auth": "viewer",
      "canonicalMutation": false
    },
    {
      "method": "POST",
      "path": "/FranchiseHub/v1/franchises/{franchiseId}/progress/restart",
      "auth": "viewer",
      "canonicalMutation": true,
      "explicitIntent": true
    },
    {
      "method": "POST",
      "path": "/FranchiseHub/v1/franchises/{franchiseId}/progress/credit",
      "auth": "viewer",
      "canonicalMutation": true,
      "explicitIntent": true
    },
    {
      "method": "POST",
      "path": "/FranchiseHub/v1/franchises/{franchiseId}/progress/reconcile",
      "auth": "viewer",
      "canonicalMutation": true,
      "explicitIntent": true
    },
    {
      "method": "GET",
      "path": "/FranchiseHub/v1/diagnostics",
      "auth": "viewer",
      "canonicalMutation": false
    }
  ],
  "sessionLifecycle": {
    "states": [
      "prepared",
      "dispatching",
      "awaiting_verification",
      "playing",
      "paused",
      "advancing",
      "completed",
      "failed",
      "cancelled"
    ],
    "transitions": {
      "prepared": [
        "dispatching",
        "failed",
        "cancelled"
      ],
      "dispatching": [
        "awaiting_verification",
        "failed",
        "cancelled"
      ],
      "awaiting_verification": [
        "playing",
        "failed",
        "cancelled"
      ],
      "playing": [
        "paused",
        "advancing",
        "completed",
        "failed",
        "cancelled"
      ],
      "paused": [
        "awaiting_verification",
        "cancelled",
        "failed"
      ],
      "advancing": [
        "awaiting_verification",
        "completed",
        "failed",
        "cancelled"
      ],
      "completed": [],
      "failed": [],
      "cancelled": []
    },
    "verifiedStartRequired": true,
    "dispatchConfirmsPlayback": false,
    "completionIdempotent": true,
    "completedAndFailedAreTerminal": true,
    "requiresOwnerLease": true
  },
  "progressPolicy": {
    "canonicalKey": [
      "userId",
      "franchiseId",
      "orderId"
    ],
    "independentModeCanMutateCanonical": false,
    "completionKey": [
      "userId",
      "franchiseId",
      "orderId",
      "occurrenceId"
    ],
    "progressChangesOnlyOnVerifiedJellyfinEventOrExplicitAuthorizedAction": true,
    "duplicateMediaOccurrencesDistinct": true
  },
  "httpErrors": {
    "staleRevision": 409,
    "ambiguousOccurrence": 409,
    "activeSessionConflict": 409,
    "unplayableSelection": 422,
    "playbackUnverified": 424,
    "capabilityUnavailable": 503
  },
  "compatibility": {
    "upstreamInput": "schemaVersion:1 JSON",
    "upstreamOutput": "schemaVersion:1 JSON",
    "nativeOutput": "versioned package with optional artwork and per-user progress",
    "oldRuntimeRoutes": "FranchiseExplorer",
    "newRuntimeRoutes": "FranchiseHub/v1",
    "dualInstallationAllowed": false
  },
  "fixture": {
